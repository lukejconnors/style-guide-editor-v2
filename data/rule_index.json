    {
      "id": "bbfe3920-5343-4032-8753-b74746d594c4",
      "title": "districts",
      "text": "Use figures even when the district number is smaller than 10: *1st Congressional District* or *1st District* not *First Congressional District, First District.* When abbreviating, use postal shorthand and add zero to single-digit districts: *NH-01, NY-04.*",
      "terms": [
        "nh-1",
        "1st congressional district",
        "first district",
        "1st district",
        "ny-04",
        "nh-01",
        "first congressional district",
        "ny-4"
      ],
      "patterns": [
        "(?i)\\b(first|second|third|fourth|fifth|sixth|seventh|eighth|ninth)\\s+(congressional\\s+)?district\\b",
        "(?i)\\b[1-9](st|nd|rd|th)\\s+(congressional\\s+)?district\\b",
        "(?i)\\b(AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY)[-\u2013](?:0[1-9]|[1-9]\\d)\\b",
        "(?i)\\b(AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY)[-\u2013][1-9]\\b"
