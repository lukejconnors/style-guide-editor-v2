    {
      "id": "b1ee4b05-82e5-48cb-9b1d-e382dc90439c",
      "title": "Honorifics",
      "text": "Do not use honorifics, *Mr., Mrs., Ms., Miss,* outside of direct quotations or quoted material, and do not use them to distinguish between people with the same last name. Include period if used. Also, see our [entry on Dr.](https://stylebook.politicoapps.com/rule/292ca63a-8900-4589-ace4-b233d06ebd59)",
      "terms": [
        "mr.",
        "ms.",
        "mrs.",
        "dr."
      ],
      "patterns": [
        "\\b[Mm]r\\.?\\s+[A-Z][A-Za-z'\\-]+",
        "\\b[Mm]rs\\.?\\s+[A-Z][A-Za-z'\\-]+",
        "\\b[Mm]s\\.?\\s+[A-Z][A-Za-z'\\-]+",
        "\\b[Mm]iss\\.?\\s+[A-Z][A-Za-z'\\-]+",
        "\\b[Dd]r\\.?\\s+[A-Z][A-Za-z'\\-]+"
      ]
    },
    {
